worker_processes  auto;

events {
    worker_connections  ${WORKER_CONNECTIONS};
}

http {

    include    /etc/nginx/mime.types;
    client_max_body_size ${MAX_BODY_SIZE};
    index    index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/html text/css text/xml text/javascript application/javascript application/x-javascript application/xml;
    gzip_disable "MSIE [1-6]\.";

    log_format custom '$remote_addr - $remote_user [$time_local] "$request" '
                          '$status $body_bytes_sent "$http_referer" '
                          '"$http_user_agent" "$host"';
    access_log /var/log/nginx/access.log  main;
    error_log /var/log/nginx/error.log warn;

    error_log /var/log/nginx/error.log;
    sendfile     on;
    tcp_nopush   on;

    # Default server block to deny access
    server {
        listen 80 default_server;
        server_name _;

        location / {
            deny all;  # Deny access to all paths
        }
    }

    include /etc/nginx/sites-enabled/*
}
